FROM node:22-alpine AS ui-builder
WORKDIR /src/admin/server/webui
COPY admin/server/webui/package*.json ./
RUN npm ci
COPY admin/server/webui ./
RUN npm run build

FROM golang:1.26-alpine AS builder
RUN apk add --no-cache build-base
WORKDIR /src

COPY admin/server/go.mod admin/server/go.sum ./
RUN go mod download

COPY admin/server/*.go ./
COPY --from=ui-builder /src/admin/server/webui/dist ./webui/dist
RUN CGO_ENABLED=1 GOOS=linux GOARCH=amd64 go build -trimpath -ldflags='-s -w' -o /out/admin-server .

FROM alpine:3.20
RUN apk add --no-cache ca-certificates wget
WORKDIR /app

COPY --from=builder /out/admin-server /usr/local/bin/admin-server
COPY admin/server/config.docker.yaml /etc/ufas/config.docker.yaml
RUN mkdir -p /data && chmod 0777 /data

EXPOSE 8082 9090
CMD ["admin-server", "--config", "/etc/ufas/config.docker.yaml", "serve"]
